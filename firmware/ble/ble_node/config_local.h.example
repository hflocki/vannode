// Personal settings that must not end up in git.
// Copy this file to config_local.h (same folder). config_local.h is ignored by git, so
// pulls, patches and CI builds never touch it. Only keep the lines you want to change:
// everything here wins over the defaults in config.h.
#pragma once

// ---- Plugin types (normally not needed) -------------------------------
// Every type is in the release file; devices are added in the web UI (System -> Plugins).
// 0 leaves a type out (smaller firmware). Each name appears only once.
// #define PLUGIN_DIMES      0      // gas bottle, Rotarex DIMES / SRG WAVE
// #define PLUGIN_MOPEKA_PRO 0      // gas bottle, Mopeka Pro family
// #define PLUGIN_MOPEKA_STD 0      // gas bottle, Mopeka Standard
// #define PLUGIN_BLESENSOR  0      // own BLE sensor (values at freely set positions)
// #define PLUGIN_RVTECH     0      // roof hatch RV Tech
// #define PLUGIN_CARAWATER  0      // water pump CaraWater
// #define PLUGIN_WCS_FRIDGE 0      // WCS fridge
// #define PLUGIN_WIPRO 0           // WiPro III alarm status (read-only)
// #define MAX_PLUGINS       12     // devices in total

// ---- Passwords -------------------------------------------------------
#define DEFAULT_AP_PASSWORD     "my-ap-password"   // setup access point, min. 8 characters
#define DEFAULT_OTA_PASSWORD    "my-ota-password"  // Arduino IDE network port

// ---- Factory defaults ------------------------------------------------
// Used only while nothing is stored on the device yet (first boot, factory reset or
// flashing with "Erase All Flash"). Values changed later in the web UI win.
#define DEFAULT_WIFI_SSID       "my-wifi"
#define DEFAULT_WIFI_PASSWORD   "my-wifi-password"
// #define DEFAULT_MQTT_SERVER  "192.168.1.1"
// #define DEFAULT_MQTT_PORT    1883
// #define DEFAULT_MQTT_USER     "mqtt-user"
// #define DEFAULT_MQTT_PASSWORD "mqtt-password"
// #define DEFAULT_WEB_USER      "admin"
// #define DEFAULT_WEB_PASSWORD  "web-password"

// ---- Bluetooth devices -----------------------------------------------
// MAC addresses and PINs of the pump, roof hatch and fridge are NOT set here.
// Enter them in the web UI (plugin settings, "Suchen" picks the MAC).

