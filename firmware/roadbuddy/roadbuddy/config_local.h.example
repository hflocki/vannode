// Own settings of the Road Buddy. Copy this file to config_local.h (same folder) and fill in
// your values. config_local.h is excluded by .gitignore and never ends up on GitHub.
// Everything defined here replaces the default from config.h; lines you do not need can go.
#pragma once

// WiFi
#define DEFAULT_WIFI_SSID      "YOUR_WIFI_SSID"
#define DEFAULT_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// MQTT broker
#define DEFAULT_MQTT_SERVER    "192.168.1.10"
#define DEFAULT_MQTT_PORT      1883
#define DEFAULT_MQTT_USER      "YOUR_MQTT_USER"
#define DEFAULT_MQTT_PASSWORD  "YOUR_MQTT_PASSWORD"

